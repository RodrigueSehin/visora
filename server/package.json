{
  "name": "visora-server",
  "private": true,
  "version": "0.1.0",
  "description": "VISORA API (NestJS + PostgreSQL + S3)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node scripts/dev.mjs",
    "infra": "node scripts/infra.mjs",
    "migrate": "node dist/src/database/run-migrations.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/test/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.896.0",
    "@aws-sdk/s3-request-presigner": "3.896.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/typeorm": "11.0.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "embedded-postgres": "17.5.0-beta.15",
    "s3rver": "^3.7.1",
    "supertest": "7.1.4",
    "typescript": "5.6.3"
  }
}
