# Copy to .env (never commit .env). In development, `npm run dev` provides local defaults.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://visora:visora@127.0.0.1:54320/visora
# At least 32 random characters in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-secret-value
# true behind HTTPS (production).
COOKIE_SECURE=false
S3_ENDPOINT=http://127.0.0.1:4569
S3_REGION=us-east-1
S3_BUCKET=visora
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
# true for MinIO / SeaweedFS / s3rver; false for AWS S3.
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=100
